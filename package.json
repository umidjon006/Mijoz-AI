{
  "name": "sotuv-trener",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI mijoz trenajyori — standalone drop-in modul (module/) + lokal harness (harness/).",
  "workspaces": [
    "harness"
  ],
  "scripts": {
    "db:up": "npm run db:up -w sotuv-trener-harness",
    "db:down": "npm run db:down -w sotuv-trener-harness",
    "db:reset": "npm run db:reset -w sotuv-trener-harness",
    "db:init": "npm run db:init -w sotuv-trener-harness",
    "verify": "npm run verify -w sotuv-trener-harness",
    "verify:training": "npm run verify:training -w sotuv-trener-harness",
    "verify:training:core": "npm run verify:training:core -w sotuv-trener-harness",
    "play": "npm run play -w sotuv-trener-harness --",
    "smoke:llm": "npm run smoke:llm -w sotuv-trener-harness --",
    "typecheck": "npm run typecheck -w sotuv-trener-harness",
    "calibrate": "npm run calibrate -w sotuv-trener-harness --",
    "bench:voices": "npm run bench:voices -w sotuv-trener-harness --",
    "bench:record": "npm run bench:record -w sotuv-trener-harness",
    "bench:stt": "npm run bench:stt -w sotuv-trener-harness --",
    "bench:tts": "npm run bench:tts -w sotuv-trener-harness --"
  }
}
