# Nusxa oling: cp .env.example .env  — keyin FAQAT GEMINI_API_KEY ni to'ldiring.
# Bu faylda HECH QANDAY qiymat yo'q, faqat NOMLAR. Haqiqiy kalitlar faqat harness/.env da.
# Bo'sh qiymat = koddagi default (pastda "default:" deb yozilgan). Yangi dasturchiga
# faqat GEMINI_API_KEY kerak: miya (mijoz LLM) va ovoz chiqishi (TTS) — Gemini;
# ovoz kirishi (STT) — LOKAL model (kalit kerak emas, README: "Lokal STT").
#
# Ishga tushirish (harness papkasidan):
#   bir marta:                        npm run stt:setup   (GPU bo'lsa: npm run stt:setup -- --cuda)
#   oddiy (kompaniya, faqat Gemini):  npm run dev          (lokal STT'ni ham o'zi ishga tushiradi)
#   + shaxsiy OpenAI zaxirasi:        npx tsx --env-file=.env --env-file=$HOME/.config/sales-copilot-personal.env src/dev.ts
# Faqat lokal harness uchun. Hech qanday haqiqiy maxfiy ma'lumot yo'q.

# === YAGONA MAJBURIY KALIT ===================================================
# KOMPANIYA kaliti (Gemini, pullik tarif). Faqat harness/.env da saqlanadi.
GEMINI_API_KEY=

# docker-compose host porti (standart 5432 EMAS). default: 55433
# masalan: POSTGRES_PORT=55433
POSTGRES_PORT=

# Superuser ulanishi — faqat sxema/rol yaratish uchun (db:init). Bo'sh = lokal default.
# masalan: SUPERUSER_DATABASE_URL=postgres://postgres:<parol>@127.0.0.1:55433/sotuv_trener
SUPERUSER_DATABASE_URL=

# Cheklangan ilova roli — RLS shu rol ustida sinaladi (verify:training). Bo'sh = lokal default.
# masalan: TRAINING_DATABASE_URL=postgres://trainer_app:<parol>@127.0.0.1:55433/sotuv_trener
TRAINING_DATABASE_URL=

# --- LLM "miya" (faqat harness; module/ hech qanday SDK bilmaydi) ---
# Provayder: gemini | openai-compatible | anthropic.  default: gemini
# (Interactions API, /v1beta/interactions; JSON — strukturali chiqish).
TRAINER_PROVIDER=
# Kalit QAYSI env o'zgaruvchisida (kalitning o'zi emas, NOMI). default: GEMINI_API_KEY
TRAINER_API_KEY_ENV=
# Mijoz navbati modeli. default: gemini-3.8-flash
TRAINER_MODEL=
# Baholash modeli. default: TRAINER_MODEL
TRAINER_SCORING_MODEL=
# Gemini fikrlash darajasi: low | medium | high (gemini-3.8-flash'da O'CHIRIB BO'LMAYDI).
# default: low (jonli suhbat — tez). Baholash uchun alohida; default: TRAINER_THINKING_LEVEL.
# masalan: TRAINER_SCORING_THINKING_LEVEL=medium
TRAINER_THINKING_LEVEL=
TRAINER_SCORING_THINKING_LEVEL=
# Ixtiyoriy: Gemini endpoint. default: https://generativelanguage.googleapis.com/v1beta
GEMINI_BASE_URL=
# Gemini xavfsizlik filtri: default (harassment=block_only_high, hate/sexual/dangerous=
# block_medium_and_above) | off (hech narsa yuborilmaydi = provayder default'i "off").
# Bloklansa: mijoz javobi yumshoqroq qayta so'raladi, keyin neytral gap (ssenariy rejimi).
GEMINI_SAFETY=
# Zaxira provayder: off | openai. default: off.
# openai — Gemini 429/503/timeout bilan (qayta urinishlardan keyin ham) yiqilsa
# OpenAI'ga o'tadi, FAQAT OPENAI_API_KEY bo'lsa (shaxsiy fayl, repo'da EMAS).
# Har o'tish log'ga yoziladi: "[llm] FALLBACK gemini/... -> openai-compatible/...".
# Kalit bo'lmasa — o'tilmaydi, aniq xabar chiqadi.
# masalan: TRAINER_FALLBACK=openai
TRAINER_FALLBACK=
# Zaxira sozlamasi. default: gpt-6-luna, https://api.openai.com/v1, OPENAI_API_KEY, none, schema
TRAINER_FALLBACK_MODEL=
TRAINER_FALLBACK_BASE_URL=
TRAINER_FALLBACK_API_KEY_ENV=
TRAINER_FALLBACK_REASONING_EFFORT=
TRAINER_FALLBACK_JSON_MODE=
# Bitta so'rov chegarasi (ms). default: 60000 / 120000.
TRAINER_TIMEOUT_MS=
TRAINER_SCORING_TIMEOUT_MS=
# 0 — har LLM chaqiruvining log qatorini o'chiradi. default: yoqilgan.
# Log: provider, model, latency, tokens=kirish/chiqish, reasoning=thinking, cost=$ (pricing.ts).
TRAINER_LLM_LOG=

# --- Faqat TRAINER_PROVIDER=openai-compatible uchun (Luna va boshqalar) ---
# Shaxsiy Luna'ni ASOSIY qilish (shaxsiy faylga yozing, harness/.env ga EMAS):
#   TRAINER_PROVIDER=openai-compatible
#   TRAINER_BASE_URL=https://api.openai.com/v1
#   TRAINER_API_KEY_ENV=OPENAI_API_KEY
#   TRAINER_MODEL=gpt-6-luna
#   TRAINER_SCORING_MODEL=gpt-6-luna
#   TRAINER_JSON_MODE=schema
#   TRAINER_REASONING_EFFORT=none
TRAINER_BASE_URL=
# schema | object | prompt. default: object
TRAINER_JSON_MODE=
# none | minimal | low | medium | high. Bo'sh = yuborilmaydi.
TRAINER_REASONING_EFFORT=
TRAINER_SCORING_REASONING_EFFORT=
# auto | max_tokens | max_completion_tokens. default: auto
TRAINER_MAX_TOKENS_PARAM=
# Faqat TRAINER_PROVIDER=anthropic uchun
ANTHROPIC_API_KEY=

# --- Ovoz kirishi (STT) ---
# local-doniyor | openai. default: local-doniyor (Doniyor'ning GigaAM s1 modeli,
# stt/serve.py, faqat 127.0.0.1; kalit kerak emas, narx $0).
# openai — faqat shaxsiy OPENAI_API_KEY fayli (ikkinchi --env-file) va OPENAI_STT_MODEL bilan.
# Zaxira YO'Q: servis ishlamasa ovozli navbat aniq xato beradi ("npm run stt:start").
STT_PROVIDER=
# Lokal servis manzili (faqat loopback). default: http://127.0.0.1:5190
STT_LOCAL_URL=
# Lokal servis qurilmasi: auto | cpu | cuda. default: auto (CUDA bo'lsa — GPU)
STT_DEVICE=
# Ixtiyoriy: boshqa venv yo'li. default: stt/.venv
STT_VENV=

# --- Ovoz chiqishi (TTS) ---
# gemini | openai. default: gemini (GEMINI_API_KEY bilan yetarli)
VOICE_TTS_PROVIDER=
# default: gemini-3.8-flash-tts
GEMINI_TTS_MODEL=
# Ovoz profillari (persona jinsi + yoshi -> ovoz va uslub). default: harness/tts-voices.json
GEMINI_TTS_VOICES_FILE=
# Zaxira TTS: TRAINER_FALLBACK=openai bo'lsa va OPENAI_API_KEY + OPENAI_TTS_MODEL bor bo'lsa.
# Oqimli zaxira uchun format mos bo'lishi kerak: OPENAI_TTS_FORMAT=wav.
# Narxlar (LLM va TTS) — harness/src/pricing.ts (2027-01-01 dan Gemini narxi 2x).
# E2E sinovida TTS so'rovlari orasidagi pauza, ms (Tier 1: 10 so'rov/daqiqa). default: 6500
E2E_TTS_GAP_MS=

# Soxta (demo) LLM — FAQAT ataylab qo'yilganda ishlaydi.
# Kalit yo'q bo'lsa jim-jitlik bilan demo'ga O'TILMAYDI, skript to'xtaydi.
DEMO_LLM=

# --- Ovoz (Step 3 benchmark; faqat harness) ---
# Azure Speech: STT (qisqa audio REST) va neural TTS
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Google Cloud: Speech-to-Text (sinxron) va Text-to-Speech
# (API key'da Cloud Speech-to-Text va Cloud Text-to-Speech yoqilgan bo'lishi kerak)
GOOGLE_API_KEY=
# Yozib olish sahifasining porti
# masalan: BENCH_PORT=5174
BENCH_PORT=

# --- Lokal Postgres (dockersiz; npm run db:local:start) ---
# Klaster papkasi (git'ga kirmaydi)
PG_LOCAL_DATA=
# initdb/pg_ctl/psql qayerda (topilmasa avtomatik qidiriladi)
PG_BIN=

# --- Baholash (Step 4) ---
# Baholash modeli yuqorida (TRAINER_SCORING_MODEL, TRAINER_SCORING_THINKING_LEVEL).
# Bo'sh = harness/data/business-profile.json (+ ixtiyoriy sales-script.md).
# Demo profil kaliti (o_quv_markaz | taksi | ovqat_yetkazish) — faqat sinash uchun.
HARNESS_PROFILE=
# Harness backend porti (route'lar va frontend uchun)
# masalan: HARNESS_PORT=5180
HARNESS_PORT=
# Rahbariyatga ko'rsatish rejimi: 1 — ovoz matni yuborishdan oldin tekshiriladi
# (default), debug va provayder paneli yashirin, xatolar do'stona, "Yangi mashq".
# Bo'sh = o'chiq.
DEMO_PRESENTATION=
# UI'da ko'rsatiladigan mijoz turlari (vergul bilan): ready_buyer, negotiator,
# problematic, info_seeker. Bo'sh = to'rttalasi. Noma'lum kalit — server startda xato.
DEMO_ARCHETYPES=
# Harness'dagi soxta auth (FAQAT lokal): header orqali dev foydalanuvchi.
# Bo'sh = yoqilgan; o'chirish faqat aniq HARNESS_AUTH=0 bilan.
# masalan: HARNESS_AUTH=1
HARNESS_AUTH=
# Rahbar (ssenariy yaratadi/tahrirlaydi/arxivlaydi) foydalanuvchi id'lari, vergul bilan.
# Bo'sh = 22222222-... (demo rahbar); 33333333-... — demo sotuvchi (faqat mashq qiladi).
# UI'da yuqori paneldagi "kim: Rahbar/Sotuvchi" shu ikkisini almashtiradi.
HARNESS_MANAGER_USER_IDS=

# --- Model bake-off (Step 2b; faqat harness) ---
# Nomzodlar 'harness/bakeoff.config.json' da. Kalitlar FAQAT shu yerda.
# Anthropic nomzodlari yuqoridagi ANTHROPIC_API_KEY dan foydalanadi.
# Qo'shimcha (OpenAI-mos) provayderlar uchun — kerak bo'lsa yoqing:
GROQ_API_KEY=
GLM_API_KEY=

# --- OpenAI ovoz (IXTIYORIY: STT_PROVIDER=openai yoki VOICE_TTS_PROVIDER=openai / TTS zaxirasi) ---
# Bitta kalit yetarli. Model nomlari ATAYLAB kodda yo'q — ularni
# 'npm run diag:voice' kalitga ochiq modellardan aniqlab, tavsiya qiladi.
# IXTIYORIY. Bu kompaniya kaliti EMAS: harness/.env ga yozmang.
# Kerak bo'lsa alohida faylda saqlang va ikkinchi --env-file bilan bering
# (README / .env.example tepasidagi buyruqqa qarang). Yo'q bo'lsa Luna/OpenAI
# yo'llari aniq xabar bilan to'xtaydi, ovoz rejimi esa o'chadi.
OPENAI_API_KEY=
# Kalit boshqa o'zgaruvchida bo'lsa — uning NOMI (qiymati emas)
OPENAI_VOICE_KEY_ENV=
# Bo'sh = https://api.openai.com/v1
OPENAI_BASE_URL=
# Nutq -> matn modeli (diag:voice tavsiya qiladi)
OPENAI_STT_MODEL=
# STT ga til qanday aytiladi: omit | code | prompt (bo'sh = omit).
# Ba'zi modellar language=uz ni 400 bilan rad etadi — omit/prompt xavfsiz.
# Eng yaxshisini 'npm run diag:stt' tavsiya qiladi.
OPENAI_STT_LANGUAGE_MODE=
# Matn -> nutq modeli (diag:voice tavsiya qiladi)
OPENAI_TTS_MODEL=
# Ovoz nomi (diag:voice bir nechtasini sinab, tezrog'ini tavsiya qiladi)
OPENAI_TTS_VOICE=
# Chiqish formati: mp3 | opus | wav (bo'sh = mp3)
OPENAI_TTS_FORMAT=
# Bitta STT/TTS so'rovining chegarasi, ms (bo'sh = 30000)
OPENAI_VOICE_TIMEOUT_MS=
# Narx tariflari — OpenAI narx sahifasidan O'ZINGIZ to'ldirasiz.
# Bo'sh bo'lsa sarf (sekund/belgi) yoziladi, lekin cost_usd 0 qoladi.
OPENAI_STT_PRICE_PER_MIN=
OPENAI_TTS_PRICE_PER_1M_CHARS=
OPENAI_TTS_PRICE_PER_1M_CHARS=
# Sinov xarajatini cheklaydi: bir sessiyada eng ko'p shuncha daqiqa audio
# (bo'sh = 10). Oshsa mijoz xushmuomala tugatadi.
VOICE_MAX_MINUTES_PER_SESSION=
