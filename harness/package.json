{
  "name": "sotuv-trener-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lokal (faqat dev) scaffolding: Postgres + verify skriptlari. Teammate'larga BERILMAYDI.",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:init": "tsx --env-file-if-exists=.env src/apply-sql.ts",
    "withtenant:smoke": "tsx --env-file-if-exists=.env src/withTenant.ts",
    "verify:training": "tsx --env-file-if-exists=.env ../module/backend/src/training/verify-training.ts",
    "verify:training:core": "tsx --env-file-if-exists=.env ../module/backend/src/training/verify-training-core.ts",
    "verify": "npm run verify:training && npm run verify:training:core && npm run verify:training:scoring && npm run verify:training:bakeoff && npm run verify:frontend",
    "play": "tsx --env-file-if-exists=.env src/play.ts",
    "smoke:llm": "tsx --env-file-if-exists=.env src/smoke-llm.ts",
    "typecheck": "tsc --noEmit",
    "calibrate": "tsx --env-file-if-exists=.env src/calibrate.ts",
    "bench:voices": "tsx --env-file-if-exists=.env src/bench-voices.ts",
    "bench:record": "tsx --env-file-if-exists=.env src/record-server.ts",
    "bench:stt": "tsx --env-file-if-exists=.env src/bench-stt.ts",
    "bench:tts": "tsx --env-file-if-exists=.env src/bench-tts.ts",
    "verify:training:scoring": "tsx --env-file-if-exists=.env ../module/backend/src/training/verify-training-scoring.ts",
    "serve": "tsx --env-file-if-exists=.env src/server.ts",
    "ui:dev": "vite --config frontend/vite.config.ts",
    "ui:build": "tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "dev": "tsx src/dev.ts",
    "verify:frontend": "npm run ui:build",
    "bakeoff": "tsx --env-file-if-exists=.env src/bakeoff.ts",
    "bakeoff:report": "tsx --env-file-if-exists=.env src/bakeoff-report.ts",
    "bakeoff:score": "tsx --env-file-if-exists=.env src/bakeoff-score.ts",
    "verify:training:bakeoff": "tsx --env-file-if-exists=.env src/verify-bakeoff.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.1",
    "drizzle-orm": "^0.44.6",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  }
}
