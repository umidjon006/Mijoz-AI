{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sotuv-trener.local/scenario.schema.json",
  "title": "Training scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title_uz",
    "description_uz",
    "difficulty",
    "call_direction",
    "relationship",
    "persona",
    "hidden_reason",
    "real_objection",
    "success_condition",
    "hangup_condition",
    "emotion",
    "behavior",
    "voice"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,60}$"
    },
    "title_uz": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "description_uz": {
      "type": "string",
      "minLength": 10,
      "maxLength": 600
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "call_direction": {
      "enum": [
        "inbound",
        "outbound"
      ]
    },
    "relationship": {
      "enum": [
        "new_lead",
        "existing_student_parent",
        "debtor",
        "other"
      ]
    },
    "base_archetype": {
      "enum": [
        "ready_buyer",
        "negotiator",
        "problematic",
        "info_seeker"
      ]
    },
    "max_turns": {
      "type": "integer",
      "minimum": 4,
      "maximum": 40
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gender",
        "age",
        "role",
        "name_pool",
        "backstory"
      ],
      "properties": {
        "gender": {
          "enum": [
            "male",
            "female"
          ]
        },
        "age": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 6,
              "maximum": 95
            },
            "max": {
              "type": "integer",
              "minimum": 6,
              "maximum": 95
            }
          }
        },
        "role": {
          "enum": [
            "parent",
            "self_learner",
            "grandparent",
            "teenager",
            "child",
            "businessman"
          ]
        },
        "name_pool": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          }
        },
        "backstory": {
          "type": "string",
          "minLength": 10,
          "maxLength": 600
        },
        "relation": {
          "enum": [
            "father",
            "mother",
            "grandmother",
            "grandfather",
            "brother",
            "sister",
            "self",
            "other"
          ]
        },
        "situation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "money",
            "busy",
            "studied_before"
          ],
          "properties": {
            "money": {
              "enum": [
                "good",
                "medium",
                "hard"
              ]
            },
            "busy": {
              "enum": [
                "free",
                "medium",
                "very_busy"
              ]
            },
            "studied_before": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "hidden_reason": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
    },
    "real_objection": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
    },
    "success_condition": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
    },
    "hangup_condition": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
    },
    "emotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "volatility",
        "may_hang_up",
        "traits",
        "triggers"
      ],
      "properties": {
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "anger",
            "trust",
            "interest",
            "patience"
          ],
          "properties": {
            "anger": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "trust": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "interest": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "patience": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "volatility": {
          "enum": [
            "slow",
            "medium",
            "fast"
          ]
        },
        "may_hang_up": {
          "type": "boolean"
        },
        "traits": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "jahldor",
              "shoshqaloq",
              "ishonchsiz",
              "kinoyali",
              "injiq",
              "charchagan",
              "ikkilanuvchi",
              "gapni_boluvchi",
              "kam_gapiradigan",
              "iliq"
            ]
          }
        },
        "triggers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "anger_up",
            "anger_down",
            "trust_up",
            "trust_down",
            "interest_up",
            "interest_down"
          ],
          "properties": {
            "anger_up": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "string",
                "minLength": 3,
                "maxLength": 160
              }
            },
            "anger_down": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "string",
                "minLength": 3,
                "maxLength": 160
              }
            },
            "trust_up": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "string",
                "minLength": 3,
                "maxLength": 160
              }
            },
            "trust_down": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "string",
                "minLength": 3,
                "maxLength": 160
              }
            },
            "interest_up": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "string",
                "minLength": 3,
                "maxLength": 160
              }
            },
            "interest_down": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "string",
                "minLength": 3,
                "maxLength": 160
              }
            }
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sen_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "siz_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "insult_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "hangup_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_formality",
        "allow_sen_when_angry",
        "sarcasm",
        "insult_level",
        "randomization_notes"
      ],
      "properties": {
        "default_formality": {
          "const": "siz"
        },
        "allow_sen_when_angry": {
          "type": "boolean"
        },
        "sarcasm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "insult_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "randomization_notes": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          }
        }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "base_style"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^(auto|[a-z]+_[a-z]+)$"
        },
        "base_style": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        }
      }
    }
  }
}
